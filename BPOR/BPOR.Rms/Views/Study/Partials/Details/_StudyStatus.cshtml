@using BPOR.Domain.Entities
@using BPOR.Rms.Startup
@model BPOR.Rms.Models.Study.StudyStatusViewModel
@inject ICurrentUserProvider<User> CurrentUserProvider

@if (CurrentUserProvider.IsAdmin() && Model.StudyStatus != null)
{
    <div class="govuk-button-group govuk-!-margin-left-2">
        <govuk-tag colour="Grey" class="govuk-!-margin-right-2">@Model.StudyStatus</govuk-tag>
        
        @if (Model.CanChangeStatus)
        {
            <a class="govuk-link" asp-action="" asp-route-studyId="@Model.StudyId">
                Change
            </a>
        }
    </div>
}