@using BPOR.Domain.Entities
@using BPOR.Rms.Helpers
@using BPOR.Rms.Startup
@model BPOR.Rms.Models.Study.StudyStatusViewModel
@inject ICurrentUserProvider<User> CurrentUserProvider

@if (CurrentUserProvider.IsAdmin() && !String.IsNullOrEmpty(Model.StudyStatusCode))
{
    <div class="govuk-button-group">
        <govuk-tag colour="@StudyStatusTagHelper.GetTagColour(Model.StudyStatusId!.Value)" class="status-tag">@Model.StudyStatusCode</govuk-tag>
        
        @if (Model.CanChangeStatus)
        {
            <a class="govuk-link govuk-!-margin-left-2" asp-action="Status" asp-controller="StudyEdit" asp-route-studyId="@Model.StudyId">
                Change
            </a>
        }
        
    </div>
}