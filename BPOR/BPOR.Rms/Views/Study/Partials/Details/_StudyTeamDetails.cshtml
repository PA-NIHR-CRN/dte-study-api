@using BPOR.Rms.VolunteerInformation.Data
@model BPOR.Rms.Models.Study.StudyDetailsViewModel

<div>
    <h3 class="govuk-heading-s">Study team details</h3>
    <dl class="govuk-summary-list">
        
        <summary-list-item for="Study.ChiefInvestigator"/>
        @if (Model.Study.ChiefInvestigatorEmail is not null)
        {
            <summary-list-item for="Study.ChiefInvestigatorEmail"/>
        }
        <summary-list-item for="Study.FullName"/>
        <summary-list-item for="Study.EmailAddress"/>
        @if (Model.Study.MainContactRole is not null)
        {
            <summary-list-item for="Study.MainContactRole"/>
        }

    </dl>
</div>
