@using BPOR.Rms.Helpers
@model BPOR.Rms.Models.Study.StudyFilterViewModel

@{
    var selectedStatusOptions = Model.StatusOptions
        .Where(x => x.IsSelected)
        .ToList();

    var selectedStatuses = selectedStatusOptions.Count;
}

<aside class="app-study-filter" aria-labelledby="study-filter-heading">
    <form method="get">
        <h2 id="study-filter-heading" class="govuk-heading-m">
            Filter search
        </h2>

        <details
            class="govuk-details govuk-!-margin-bottom-0"
            data-module="govuk-details">

            <summary class="govuk-details__summary">
                    <span class="govuk-details__summary-content">
                        <span class="govuk-details__summary-text govuk-heading-m govuk-!-margin-bottom-0">
                            Statuses
                        </span>

                        <span class="govuk-body-s govuk-!-margin-bottom-0">
                            @(selectedStatuses == 0
                                ? "No filters selected"
                                : $"{selectedStatuses} selected")
                        </span>
                    </span>
            </summary>

            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-visually-hidden">
                    Filter studies by status
                </legend>

                <div
                    class="govuk-checkboxes govuk-checkboxes--small govuk-!-margin-top-2"
                    data-module="govuk-checkboxes">

                    @foreach (var status in Model.StatusOptions)
                    {
                        var statusId = $"study-status-{status.Value}";

                        <div class="govuk-checkboxes__item">
                            <input
                                class="govuk-checkboxes__input"
                                id="@statusId"
                                name="statusIds"
                                type="checkbox"
                                value="@status.Value"
                                checked="@status.IsSelected"/>

                            <label
                                class="govuk-label govuk-checkboxes__label"
                                for="@statusId">
                                @status.Text
                            </label>
                        </div>
                    }
                </div>

            </fieldset>
        </details>

        @if (selectedStatusOptions.Any())
        {
            <div class="selected-filter-tags govuk-!-margin-bottom-3 govuk-!-margin-top-3">
                @foreach (var filter in selectedStatusOptions)
                {
                    <govuk-tag colour="@StudyStatusTagHelper.GetTagColour(filter.StatusType)">
                        @filter.Text
                    </govuk-tag>
                }
            </div>
        }

        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible"/>

        <button
            type="submit"
            class="govuk-button"
            data-module="govuk-button">
            Apply filters
        </button>
    </form>
</aside>