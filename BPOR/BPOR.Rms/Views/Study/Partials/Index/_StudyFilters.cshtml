@using BPOR.Domain.Entities.RefData
@using BPOR.Domain.Enums
@using BPOR.Rms.Database
@using BPOR.Rms.Helpers
@using NIHR.Infrastructure.AspNetCore
@using NIHR.Infrastructure.AspNetCore.Extensions
@model BPOR.Rms.Models.Study.StudiesViewModel

@inject ISysRefRepository<StudyStatus> SysRefStudyStatusRepository

@{
    var statuses = await SysRefStudyStatusRepository
        .GetAllAsync(s => s.Id != StudyStatusType.Draft);

    var studyStatusList = statuses.ToList();
    var allStatusesSelected =
        studyStatusList.All(status => Model.Filters.SelectedStatuses.Contains(status.Id));
}

<aside aria-labelledby="study-filter-heading" class="govuk-!-margin-bottom-4">
    <form method="get">

        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
        }
        
        <input type="hidden"
               name="allStatusesWasSelected"
               value="@allStatusesSelected.ToString().ToLower()" />

        <details
            class="govuk-details govuk-!-margin-bottom-0"
            data-module="govuk-details">

            <summary class="govuk-details__summary">
                <span class="govuk-details__summary-content">
                    <span id="study-filter-heading" class="govuk-heading-m govuk-!-margin-bottom-0">
                        Statuses
                    </span>

                    @if (Model.Filters.SelectedStatuses.Any())
                    {
                        <div class="selected-filter-tags govuk-!-margin-top-2">
                            @foreach (var filter in Model.Filters.SelectedStatuses)
                            {
                                <govuk-tag colour="@StudyStatusTagHelper.GetTagColour(filter)">
                                    @EnumHelper.GetDisplayName(filter).ToSentenceCase()
                                </govuk-tag>
                            }
                        </div>
                    }
                </span>
            </summary>

            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-visually-hidden">
                    Filter studies by status
                </legend>

                <div
                    class="govuk-checkboxes govuk-checkboxes--small govuk-!-margin-top-2"
                    data-module="govuk-checkboxes">

                    <div class="govuk-checkboxes__item">
                        <input
                            class="govuk-checkboxes__input"
                            id="study-status-all"
                            name="allStatuses"
                            type="checkbox"
                            value="true"
                            checked="@allStatusesSelected" />

                        <label
                            class="govuk-label govuk-checkboxes__label"
                            for="study-status-all">
                            All statuses
                        </label>
                    </div>

                    @foreach (var status in studyStatusList)
                    {
                        var statusId = $"study-status-{status.Id}";

                        <div class="govuk-checkboxes__item">
                            <input
                                class="govuk-checkboxes__input"
                                id="@statusId"
                                name="statusIds"
                                type="checkbox"
                                value="@status.Id"
                                checked="@Model.Filters.SelectedStatuses.Contains(status.Id)" />

                            <label
                                class="govuk-label govuk-checkboxes__label"
                                for="@statusId">
                                @status.Code.ToSentenceCase()
                            </label>
                        </div>
                    }
                </div>

            </fieldset>
        </details>

        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible govuk-!-margin-top-2"/>

        <div class="govuk-button-group">
            <button
                type="submit"
                class="govuk-button"
                data-module="govuk-button">
                Apply filter
            </button>

            @if (Model.Filters.SelectedStatuses.Any())
            {
                <a class="govuk-link"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm">
                    Clear filter
                </a>
            }
        </div>
    </form>
</aside>