@using BPOR.Domain.Enums
@model BPOR.Rms.Models.Study.StudyStatusViewModel

@{
    ViewData["Title"] = "Update study status";

    ViewData.AddBreadcrumbs(new Dictionary<string, string>
    {
        ["All studies"] = "/Study/Index",
        ["Study page"] = $"/Study/Details/{Model.StudyId}",
        ["Update study status"] = $"/Study/{Model.StudyId}/Staus/Change",
    });
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <h1 class="govuk-heading-l">
            Withdrawal reason
        </h1>

        <form asp-action="ChangeStatus"
              asp-route-studyId="@Model.StudyId"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <input type="hidden" asp-for="StudyId" />

            <fieldset class="govuk-fieldset">

                <radio-set for="@Model.StudyStatusId">

                    @foreach (var status in Model.WithdrawnReasons!)
                    {
                        <radio value="@status.Id" >
                            @status.Description
                        </radio>
                    }

                </radio-set>

            </fieldset>

            <div class="govuk-button-group">
                <button type="submit"
                        class="govuk-button"
                        data-module="govuk-button">
                    Save and continue
                </button>
            </div>

        </form>

    </div>
</div>