@using NIHR.GovUk.AspNetCore.Mvc.Views
@model NIHR.GovUk.AspNetCore.Mvc.Models.GovUkRadiosModel

<div class="govuk-form-group @(string.IsNullOrEmpty(Model.ErrorMessage) ? "" : "govuk-form-group--error")">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="govuk-error-message">
            <span class="govuk-visually-hidden">Error:</span>
            @Model.ErrorMessage
        </p>
    }

    @if (!string.IsNullOrEmpty(Model.Legend))
    {
        <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                @switch (Model.LegendHeadingLevel)
                {
                    case "h1":
                        <h1 class="govuk-fieldset__heading">@Model.Legend</h1>
                        break;
                    case "h2":
                        <h2 class="govuk-fieldset__heading">@Model.Legend</h2>
                        break;
                    case "h3":
                        <h3 class="govuk-fieldset__heading">@Model.Legend</h3>
                        break;
                    default:
                        @Model.Legend
                        break;
                }
            </legend>

            <div class="govuk-radios @GovUkStylingHelper.GetRadioLayoutClass(Model.Layout)"
                 data-module="govuk-radios">
                @Model.InnerContent
            </div>
        </fieldset>
    }
    else
    {
        <div class="govuk-radios @GovUkStylingHelper.GetRadioLayoutClass(Model.Layout)"
             data-module="govuk-radios">
            @Model.InnerContent
        </div>
    }

</div>