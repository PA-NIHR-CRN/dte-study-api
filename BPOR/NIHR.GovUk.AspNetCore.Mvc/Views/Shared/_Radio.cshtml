@model NIHR.GovUk.AspNetCore.Mvc.Models.GovUkRadioModel

@{
    var id = $"{Model.Name}-{Model.Value}";
}

<div class="govuk-radios__item">
    <input class="govuk-radios__input"
           id="@id"
           name="@Model.Name"
           type="radio"
           value="@Model.Value"
           checked="@Model.IsSelected"
           autofocus="@Model.Autofocus"
           data-aria-controls="@Model.ConditionalId" />

    <label class="govuk-label govuk-radios__label"
           for="@id">
        @Model.InnerContent
    </label>
</div>