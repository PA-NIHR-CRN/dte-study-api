@using BPOR.Domain.Enums
@using NIHR.Infrastructure.AspNetCore
@model BPOR.Rms.Ms4.Models.StudyEditViewModel

@{
    Layout = "_StudyFormLayout";
    ViewData["SubmitButtonText"] = "Save and continue";

    const string miscConditional = "conditional-withdrawn-misc";
}

@section SectionTitle
{
    <text>Study status</text>
}

<radio-set for="@Model.WithdrawnReason"
           legend="Withdrawal reason">

        @foreach (var reason in Enum.GetValues<WithdrawnReasonType>())
        {
            var isMisc = reason == WithdrawnReasonType.Other;

            <radio value="@reason"
                   conditional-id="@(isMisc ? miscConditional : null)">
                @EnumHelper.GetDisplayName(reason)
            </radio>

            @if (isMisc)
            {
                <radio-conditional id="@miscConditional" value="@reason">

                    <form-group for="@Model.WithdrawnOtherReason"
                                label="Please provide details"
                                label-class="govuk-!-heading-s">

                        <textarea asp-for="WithdrawnOtherReason"
                                  class="govuk-textarea">
                        </textarea>

                    </form-group>

                </radio-conditional>
            }
        }

</radio-set>