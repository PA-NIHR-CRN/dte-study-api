@using BPOR.Domain.Enums
@using NIHR.Infrastructure.AspNetCore
@model BPOR.Rms.Ms4.Models.StudyEditViewModel

@{
    Layout = "_StudyFormLayout";
    ViewData["SubmitButtonText"] = "Save and continue";

    const string miscConditional = "conditional-withdrawn-misc";
}

@section SectionTitle
{
    <text>Study status</text>
}

<form-group for="@Model.WithdrawnReasons"
            label-as-heading="true"
            label-class="govuk-heading-l">

    <div class="govuk-checkboxes"
         data-module="govuk-checkboxes">

        @foreach (var reason in Enum.GetValues<WithdrawnReasonType>())
        {
            var isMisc = reason == WithdrawnReasonType.Other;
            var isSelected = Model.WithdrawnReasons.Contains(reason);

            <div class="govuk-checkboxes__item">

                <input class="govuk-checkboxes__input"
                       id="WithdrawnReasons-@reason"
                       name="WithdrawnReasons"
                       type="checkbox"
                       value="@reason"
                       checked="@isSelected"
                       data-aria-controls="@(isMisc ? miscConditional : null)" />

                <label class="govuk-label govuk-checkboxes__label"
                       for="WithdrawnReasons-@reason">
                    @EnumHelper.GetDisplayName(reason)
                </label>

            </div>

            @if (isMisc)
            {
                <div class="govuk-checkboxes__conditional @(isSelected ? "" : "govuk-checkboxes__conditional--hidden")"
                     id="@miscConditional">

                    <form-group for="@Model.WithdrawnOtherReason"
                                label="Please provide details"
                                label-class="govuk-!-heading-s">

                        <textarea asp-for="WithdrawnOtherReason"
                                  class="govuk-textarea">
                        </textarea>

                    </form-group>

                </div>
            }
        }

    </div>

</form-group>