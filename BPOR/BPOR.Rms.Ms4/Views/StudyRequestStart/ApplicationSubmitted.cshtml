@model BPOR.Rms.Ms4.Models.ApplicationSubmittedViewModel

@{
    Layout = "_StudyLayout";
}

<div class="govuk-panel govuk-panel--confirmation">
    <h1 class="govuk-panel__title">
        Application submitted
    </h1>
</div>
<h2 class="govuk-heading-m">What happens next</h2>
<p class="govuk-body">
    We will inform you of the outcome of your application within <strong>5 days.</strong> You may also be contacted by our team if we need more information.
</p>

@*
Not sure where this should redirect to after submission
*@

<div class="govuk-button-group">
    @Html.ActionLink("View study", "Details", "Study", new { id = Model.StudyId }, new { @class = "govuk-button", data_module = "govuk-button" })
    @Html.ActionLink("All studies", "Index", "Study", null, new { @class = "govuk-button govuk-button--secondary", data_module = "govuk-button" })
</div>