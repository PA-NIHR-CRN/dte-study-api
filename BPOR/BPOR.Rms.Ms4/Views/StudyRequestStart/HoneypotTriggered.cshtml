@using BPOR.Rms.Ms4.Settings
@using Microsoft.Extensions.Options
@inject IOptions<StudyCreationSettings> Settings

@{
    // This is a mock page that will be displayed to the user in the event that a honeypot is triggered.
    // It is designed such that, if a false positive occurs (i.e. a genuine researcher triggers the honeypot)
    // then they will be directed to contact BPOR rather than believing their application was successful.
    
    Layout = "_StudyLayout";
    ViewData["HideProgress"] = true;
}

<h2 class="govuk-heading-l">Apply to include your study in the Be Part of Research registry</h2>
        
<p class="govuk-body">
    Online application processing is not available at present.
</p>

<p class="govuk-body">
    If you wish to apply, please email us at 
    <a href="mailto:bepartofresearch@nihr.ac.uk">bepartofresearch@nihr.ac.uk</a>
</p>

<p class="govuk-body">
    <a href="@Settings.Value.ResearcherCreationFinishRedirectUrl" role="button" class="govuk-button" data-module="govuk-button">
        Return to Be Part of Research
    </a>
</p>