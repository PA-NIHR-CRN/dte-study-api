@using BPOR.Domain.Enums
@using NIHR.Infrastructure.AspNetCore
@model BPOR.Rms.Ms4.Models.StudyRequestViewModel

@{
    Layout = "_StudyFormLayout";
}

@section SectionTitle
{
    <text>@StudyRequestEditResources.Section1Caption</text>
}

<h2 class="govuk-heading-l">Does this study have NIHR funding?</h2>

<radio-set for="@Model.NihrFundingStatus">

    <radio value="@NihrFundingStatusType.Yes">
        @EnumHelper.GetDisplayName(NihrFundingStatusType.Yes)
    </radio>

    <radio value="@NihrFundingStatusType.No">
        @EnumHelper.GetDisplayName(NihrFundingStatusType.No)
    </radio>

    <radio value="@NihrFundingStatusType.NoButApplied">
        @EnumHelper.GetDisplayName(NihrFundingStatusType.NoButApplied)
    </radio>
</radio-set>

<inset-text>

    <p class="govuk-body">
        If you are not on the RDN portfolio, you may still be eligible for funding from the NIHR.
    </p>

    <p class="govuk-body">
        If you are unsure of this, please contact
        <a href="mailto:bepartofresearch-volunteerservice@nihr.ac.uk">
            bepartofresearch-volunteerservice@nihr.ac.uk
        </a>
    </p>

</inset-text>