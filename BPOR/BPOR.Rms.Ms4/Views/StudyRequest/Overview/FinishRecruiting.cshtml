@model BPOR.Rms.Ms4.Models.OverviewViewModel

@{
    Layout = "_StudyFormLayout";
}

@section SectionTitle
{
    <text>Section 1: Overview</text>
}

<date-input day-for="@Model.FinishRecruitingDay"
            month-for="@Model.FinishRecruitingMonth"
            year-for="@Model.FinishRecruitingYear"
            legend="When will you finish recruiting to this study?"
            hint="If you don't know the exact date, provide an estimated one." />