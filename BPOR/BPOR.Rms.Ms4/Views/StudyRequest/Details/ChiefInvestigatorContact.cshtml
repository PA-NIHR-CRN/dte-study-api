@model BPOR.Rms.Ms4.Models.StudyRequestViewModel

@{
    Layout = "_StudyFormLayout";
    ViewData["Step"] = 9;
    ViewData["TotalSteps"] = 14;
}

@section SectionTitle
{
    <text>Section 2: Study details</text>
}
        
<h2 class="govuk-heading-l">Is the chief investigator the main person to contact for this study?</h2>

<radio-set for="@Model.IsChiefInvestigatorMainContact">
    <radio value="@true">Yes</radio>
    <radio value="@false">No</radio>
</radio-set>