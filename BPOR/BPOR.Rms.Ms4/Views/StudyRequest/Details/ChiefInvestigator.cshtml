@model BPOR.Rms.Ms4.Models.StudyRequestViewModel

@{
    Layout = "_StudyFormLayout";
    ViewData["Step"] = 8;
    ViewData["TotalSteps"] = 14;
}

@section SectionTitle
{
    <text>Section 2: Study details</text>
}

<h2 class="govuk-heading-l">Who is the chief investigator for this study?</h2>

<form-group for="@Model.ChiefInvestigatorName"
            label="Name"
            label-class="govuk-label">

    <input class="govuk-input"
           asp-for="@Model.ChiefInvestigatorName"
           type="text"/>

</form-group>

<form-group for="@Model.ChiefInvestigatorEmail"
            label="Email"
            label-level="h2"
            label-class="govuk-label">
    
    <input class="govuk-input"
           asp-for="@Model.ChiefInvestigatorEmail"
           type="text"/>

</form-group>