@using BPOR.Rms.Ms4
@using BPOR.Rms.Ms4.FlowGraph
@using NIHR.Infrastructure.AspNetCore.Authentication.AccessToken
@model BPOR.Rms.Ms4.Models.StudyRequestViewModel

@inject IUrlAccessTokenService UrlAccessTokenService

@{
    Layout = "_StudyFormLayout";
    ViewData["Step"] = 13;
    ViewData["TotalSteps"] = 14;
    ViewData["SubmitButtonText"] = "Submit application";
}

@functions {

    void RenderChangeLink(IGraphNode<MvcActionKey> node)
    {    
        var studyEditContext = (StudyEditContext)ViewData["StudyEditContext"];
        string changeUrl = Url.Action(node.Value.Action, node.Value.Controller, studyEditContext with {IndividualEdit = true});
        changeUrl = UrlAccessTokenService.AddCurrentAccessToken(changeUrl);
        <a class="govuk-link" href="@changeUrl">Change</a>
    }

}

@section SectionTitle
{
    <text>Section 5: Check your answers</text>
}

<h2 class="govuk-heading-l">Before submitting your application check the details you’ve provided</h2>

<h3 class="govuk-heading-m">You can change your answers from this page before saving the application.</h3>

<h3 class="govuk-heading-m">Overview</h3>
<dl class="govuk-summary-list govuk-!-margin-bottom-9">
    <gov-uk-summary-list-item for="@Model.HasEthicsApprovalDisplay">
        @{ RenderChangeLink(StudyRequestFlow.EthicsApproval); }
    </gov-uk-summary-list-item>

    <gov-uk-summary-list-item for="@Model.InclusionInRdnPortfolioStatusDisplay">
        @{ RenderChangeLink(StudyRequestFlow.InclusionInRdnPortfolio); }
    </gov-uk-summary-list-item>

    @if (Model.CpmsId != null)
    {
        <gov-uk-summary-list-item for="@Model.CpmsId">
            @{ RenderChangeLink(StudyRequestFlow.InclusionInRdnPortfolio); }
        </gov-uk-summary-list-item>
    }

    @if (Model.NihrFundingStatusDisplay != null)
    {
        <gov-uk-summary-list-item for="@Model.NihrFundingStatusDisplay">
            @{ RenderChangeLink(StudyRequestFlow.NihrFunding); }
        </gov-uk-summary-list-item>
    }

    <gov-uk-summary-list-item
        name="When will you finish recruiting to this study?">

        <summary-value>
            @Model.RecruitmentEndDate?.ToString("dd/MM/yyyy")
        </summary-value>
        
        @{ RenderChangeLink(StudyRequestFlow.FinishRecruiting); }
    </gov-uk-summary-list-item>
</dl>

<h3 class="govuk-heading-m">Study details</h3>
<dl class="govuk-summary-list govuk-!-margin-bottom-9">
    <gov-uk-summary-list-item for="@Model.StudyTitle">
        @{ RenderChangeLink(StudyRequestFlow.StudyDescription); }
    </gov-uk-summary-list-item>
    
    <gov-uk-summary-list-item for="@Model.StudyDescription">
        @{ RenderChangeLink(StudyRequestFlow.StudyDescription); }
    </gov-uk-summary-list-item>
    
    <gov-uk-summary-list-item for="@Model.HasMultipleResearchLocationsDisplay">
        @{ RenderChangeLink(StudyRequestFlow.ResearchLocations); }
    </gov-uk-summary-list-item>
    
    <gov-uk-summary-list-item for="@Model.SinglePersonResponsibleForRecruitingDisplay">
        @{ RenderChangeLink(StudyRequestFlow.ResearchManager); }
    </gov-uk-summary-list-item>
    
    <gov-uk-summary-list-item
        name="Who is the chief investigator for your study?">

        <summary-value>
            <p class="govuk-body">
                <strong>Name:</strong><br />
                @Model.ChiefInvestigatorName
            </p>

            <p class="govuk-body">
                <strong>Email:</strong><br />
                @Model.ChiefInvestigatorEmail
            </p>
        </summary-value>

        @{ RenderChangeLink(StudyRequestFlow.ChiefInvestigator); }
    </gov-uk-summary-list-item>
    
    @if (Model.MainContactName != null)
    {
        <gov-uk-summary-list-item
            name="Who is the main point of contact for the study?">

            <summary-value>
                <p class="govuk-body">
                    <strong>Name:</strong><br />
                    @Model.MainContactName
                </p>

                <p class="govuk-body">
                    <strong>Role:</strong><br />
                    @Model.MainContactRole
                </p>

                <p class="govuk-body">
                    <strong>Email:</strong><br />
                    @Model.MainContactEmail
                </p>
            </summary-value>

            @{ RenderChangeLink(StudyRequestFlow.MainContact); }
        </gov-uk-summary-list-item>
    }
</dl>

<h3 class="govuk-heading-m">Study sponsorship</h3>
<dl class="govuk-summary-list govuk-!-margin-bottom-9">
    <gov-uk-summary-list-item for="@Model.SponsorName">
        @{ RenderChangeLink(StudyRequestFlow.SponsorOrganisation); }
    </gov-uk-summary-list-item>
</dl>

<h3 class="govuk-heading-m">Participant details</h3>
<dl class="govuk-summary-list govuk-!-margin-bottom-9">
    <gov-uk-summary-list-item for="@Model.InclusionCriteria">
        @{ RenderChangeLink(StudyRequestFlow.ParticipantDetails); }
    </gov-uk-summary-list-item>
</dl>