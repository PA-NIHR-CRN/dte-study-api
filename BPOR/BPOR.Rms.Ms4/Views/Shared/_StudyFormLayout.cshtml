@using AngleSharp.Io
@using BPOR.Rms.Ms4
@using BPOR.Rms.Ms4.FlowGraph
@using Microsoft.AspNetCore.WebUtilities
@{
    Layout = "_StudyLayout";
    var submitButtonText = ViewData["SubmitButtonText"] as string ?? "Continue";
    var hideSectionTitle = ViewData["HideSectionTitle"] as bool? ?? false;
}

@if (IsSectionDefined("SectionTitle"))
{
    if (hideSectionTitle)
    {
        IgnoreSection("SectionTitle");
    }
    else
    {
        <h1 class="govuk-heading-s section-heading">
            @await RenderSectionAsync("SectionTitle")
        </h1>
    }
}

<form method="post">
    
    @RenderBody()

    <button class="govuk-button" type="submit">
        @submitButtonText
    </button>

</form>